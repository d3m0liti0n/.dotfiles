#!/bin/sh
# The second DP lane to the dock only equalises on some link-training attempts.
# i915 gives a 2-lane link just two tries per modeset and then drops to 1 lane,
# which cannot carry 2560x1440. This script keeps retraining (rate forced to HBR2,
# lane count left to the driver) until the link is up on 2+ lanes, or gives up.
# While it works it holds $BUSY so that dphotplug leaves the output alone.
D=/sys/kernel/debug/dri/0/DP-2
RATE=540000
TRIES=8
BUSY=/run/dock-dp-retrain.busy
GAVEUP=/run/dock-dp-retrain.gaveup

[ -e "$D/i915_dp_force_link_retrain" ] || exit 0

exec 9>/run/dock-dp-retrain.lock
flock -n 9 || exit 0

ext_connected() {
  for c in /sys/class/drm/card0-DP-*; do
    [ "$(cat "$c/status" 2>/dev/null)" = connected ] && return 0
  done
  return 1
}
max_lanes() { cat "$D/i915_dp_max_lane_count" 2>/dev/null || echo 0; }
lanes_ok() { [ "$(max_lanes)" -ge 2 ] 2>/dev/null; }
poke() { udevadm trigger --action=change --subsystem-match=drm --sysname-match=card0; }

sleep 3
if ! ext_connected; then rm -f "$GAVEUP"; exit 0; fi
lanes_ok && exit 0
[ -e "$GAVEUP" ] && exit 0        # already gave up for this docking

trap 'rm -f "$BUSY"' EXIT
: > "$BUSY"

i=0
while [ "$i" -lt "$TRIES" ]; do
  i=$((i + 1))
  ext_connected || exit 0
  logger -t dock-dp-retrain "link limited to $(max_lanes) lane(s), retraining (try $i)"
  echo auto    > "$D/i915_dp_force_lane_count"
  echo "$RATE" > "$D/i915_dp_force_link_rate"
  echo 1       > "$D/i915_dp_force_link_retrain"
  sleep 5
  if lanes_ok; then
    logger -t dock-dp-retrain "link up on $(max_lanes) lanes after $i tries"
    rm -f "$BUSY"
    poke        # let dphotplug switch to / confirm 2K
    exit 0
  fi
done
: > "$GAVEUP"
logger -t dock-dp-retrain "gave up after $TRIES tries, link stays on 1 lane"
rm -f "$BUSY"
poke            # let dphotplug fall back to 1920x1080
